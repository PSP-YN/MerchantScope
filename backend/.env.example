APP_ENV=demo
DATABASE_URL=sqlite:///./trace_demo.db
# Required in production; use unique high-entropy values.
TRACE_ANALYST_TOKEN=
TRACE_INVESTIGATOR_TOKEN=
TRACE_ADMIN_TOKEN=
TRACE_REVIEWER_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional risk-score weights. Defaults: 0.25, 0.25, 0.25, 0.15, 0.10.
TRACE_WEIGHT_BEHAVIOUR=0.25
TRACE_WEIGHT_CATEGORY=0.25
TRACE_WEIGHT_GRAPH=0.25
TRACE_WEIGHT_PAYMENT=0.15
TRACE_WEIGHT_CONTEXT=0.10
